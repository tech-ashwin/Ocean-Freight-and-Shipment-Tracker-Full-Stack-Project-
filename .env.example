# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB Database Configuration:
# Provide your MongoDB Atlas connection string or local MongoDB URI.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/bluspark_logistics?retryWrites=true&w=majority"
MONGODB_DB_NAME="bluspark_logistics"

# JWT Authentication Secrets (256-bit cryptographic secrets)
JWT_ACCESS_SECRET="a73b033715bbde9f6dc7fd3ac2d72f2a563a611072083d83a3a9ab98348a0317"
JWT_REFRESH_SECRET="e507b4f57df0d33094a83119d2bfc47b30c53755053dd56326c8aa93b5466ce8"
